	"tokenColors": [
		{
			"settings": {
				"foreground": "#D8E1F1"
			}
		},
		{
			"scope": "comment",
			"settings": {
				"foreground": "#6E7D96",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string", "constant.other.symbol"],
			"settings": {
				"foreground": "#A9D7A5"
			}
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": {
				"foreground": "#E9B35C"
			}
		},
		{
			"scope": ["keyword", "storage", "storage.type"],
			"settings": {
				"foreground": "#A9B9FF"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#7FD5E2"
			}
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
			"settings": {
				"foreground": "#C8A9F2"
			}
		},
		{
			"scope": ["variable", "support.variable", "entity.name.variable"],
			"settings": {
				"foreground": "#D8E1F1"
			}
		},
		{
			"scope": ["entity.name.tag", "entity.other.attribute-name"],
			"settings": {
				"foreground": "#F09D86"
			}
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#FFB4BE"
			}
